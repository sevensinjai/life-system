# Copy to .env and adjust. All keys use the APP_ prefix.
APP_APP_NAME=system-api
APP_ENVIRONMENT=development
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000
# JSON list of allowed origins; narrow this before deploying.
APP_CORS_ORIGINS=["*"]

APP_DATABASE_URL=sqlite:///./system.db

# Required in production. Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
APP_JWT_SECRET=dev-only-insecure-secret-change-me-before-deploying
APP_ACCESS_TOKEN_EXPIRE_MINUTES=20160

# Progression tuning. Changing these reshapes the whole level curve.
APP_EXP_CURVE_BASE=100
APP_EXP_CURVE_EXPONENT=1.5
APP_STAT_POINTS_PER_LEVEL=3
APP_PENALTY_EXP_MULTIPLIER=1.0
